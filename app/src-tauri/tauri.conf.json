{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sectionist",
  "mainBinaryName": "Sectionist",
  "version": "1.5.1",
  "identifier": "com.sectionist.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sectionist",
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "fileAssociations": [
      {
        "ext": ["txt"],
        "name": "Plain Text File",
        "description": "Plain text file",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["md"],
        "name": "Markdown File",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  }
}
